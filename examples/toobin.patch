-	.HBlank(adj_hb),
-	.VBlank(adj_vb),
-	.HSync(adj_hs),
-	.VSync(adj_vs),
+	.ce_pix(ce_pix),
+	.RGB_in({R, G, B}),
+	.HBlank(HBlank),
+	.VBlank(VBlank),
+	.HSync(HSync),
+	.VSync(VSync),
+	.CLK_VIDEO(),
+	.CE_PIXEL(NATIVE_CE),
+	.VGA_R(NATIVE_R),
+	.VGA_G(NATIVE_G),
+	.VGA_B(NATIVE_B),
+	.VGA_HS(NATIVE_HS),
+	.VGA_VS(NATIVE_VS),
 	.VGA_DE(vga_de_raw),
-	.fx(fx)
+	.VGA_SL(),
+	.fx(fx),
+	.forced_scandoubler(1'b0),
+	.gamma_bus(gamma_bus)
 );
 
 // Scale (status[22:20]) maps onto video_freak's SCALE encoding, which is
@@ -315,11 +350,11 @@ wire [2:0] scale_sel = (status[22:20] == 3'd0) ? 3'd0 :   // Normal
