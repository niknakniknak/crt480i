+// Video outputs, SD build. The native 512x384 / 25 kHz picture never reaches VGA.
+//   VGA_*    analog: crt_480i only, 15 kHz 480i (below). sys_top never puts the scaler on VGA
+//            in this build, and direct_video sends this same stream to HDMI.
+//   NATIVE_* the HDMI scaler: the native picture through arcade_video, with the usual Aspect
+//            ratio, Orientation, Scale and gamma.
+
+// ---- VGA: CRT 15kHz 480i (O[68:51]) ---------------------------------------------------------
+// Re-times the native raster into 525-line 480i for a low-res CRT (turned for this vertical
+// game): each field carries alternate source lines, one field per game frame. It stores the
+// 10-bit pen (exact colours, both parities in ~48 M10K) and looks colours up through a mirror of
+// the color RAM. It drives the VGA pins directly: arcade_video re-times VSync onto HSync, which
+// would remove field 1's half-line offset (no interlace).
+wire       ce480, i480_field;
+wire [7:0] i480_r, i480_g, i480_b;
+wire       i480_hs, i480_vs, i480_de;
+
+crt_480i #(.CLK_HZ(64_000_000), .CLK_DIV(6), .PW(10), .LUT_EXT(1), .LUT_LAT(2)) crt480i (   // 64 MHz / 6 = 10.67 MHz pixels
+	.clk      (clk_sys),
+	.ce_in    (ce_pix),
+	.pix_in   (core_pen),
+	.vs_in    (VSync), .de_in(~HBlank & ~VBlank),
+	.hoffset  ($signed({status[63], status[63:58]})),          // H-Position
+	.voffset  ($signed({{2{status[68]}}, status[68:64]})),    // V-Position
+	.deflicker(status[53:51]),
+	.vheight  (status[57:55]),
+	.lut_addr (pal480_addr),
+	.lut_rgb  (pal480_rgb),
+	.ce_out   (ce480),
+	.r_out    (i480_r), .g_out(i480_g), .b_out(i480_b),
+	.hs_out   (i480_hs), .vs_out(i480_vs), .de_out(i480_de),
+	.hb_out   (), .vb_out(),
+	.field    (i480_field),
+	.locked   ()
 );
 
+assign CE_PIXEL = ce480;
+assign VGA_R    = i480_r;
+assign VGA_G    = i480_g;
+assign VGA_B    = i480_b;
+assign VGA_HS   = i480_hs;
+assign VGA_VS   = i480_vs;
+assign VGA_DE   = i480_de;
+assign VGA_F1   = i480_field;
+assign VGA_SL   = 2'd0;
+
+// ---- HDMI: the native picture ---------------------------------------------------------------
+// arcade_video's scandoubler is for 31 kHz VGA; here its output only feeds the HDMI scaler.
 wire vga_de_raw;
 
 arcade_video #(.WIDTH(512), .DW(24)) arcade_video
 (
