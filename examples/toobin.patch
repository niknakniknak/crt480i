@@ -180,15 +183,30 @@ module toobin_video
 		.clk(clk),
 		.a_addr(pal_wr_addr), .a_din(pal_wr_data), .a_we(pal_wr ? pal_wr_be : 2'b00), .a_dout(pal_rdata),
 		.b_addr(pen_s4),      .b_din(16'b0),       .b_we(2'b00), .b_re(ce),          .b_dout(color_s5) );
+	logic  [9:0] pen_s5;
 	always_ff @(posedge clk) begin
 		if (ce) begin
 			// stage 3 -> 4: latch merged pen + coordinate
 			pen_s4 <= pen_s3; ho_s4 <= pf_ho; vo_s4 <= pf_vo[8:0];
 			// stage 4 -> 5: color RAM read + coordinate  (port B)
-			ho_s5 <= ho_s4; vo_s5 <= vo_s4;
+			ho_s5 <= ho_s4; vo_s5 <= vo_s4; pen_s5 <= pen_s4;
 		end
 	end
 
+	// CRT 480i: a mirror of the color RAM (same CPU writes) with its own read port, so the
+	// 480i stage can look colours up at its own time. Read every clock: 1-clk latency.
+	logic [15:0] color_480;
+	toobin_dpram #(.DW(16), .AW(10)) u_palram_480i (
+		.clk(clk),
+		.a_addr(pal_wr_addr), .a_din(pal_wr_data), .a_we(pal_wr ? pal_wr_be : 2'b00), .a_dout(),
+		.b_addr(pal480_addr), .b_din(16'b0),       .b_we(2'b00), .b_re(1'b1),        .b_dout(color_480) );
+	wire [7:0] r480, g480, b480;
+	toobin_palette u_pal_480i (.color(color_480), .intensity(intensity), .r(r480), .g(g480), .b(b480));
+	// Registered: the palette maths (brightness multiply + /31) gets a clock of its own, and the
+	// 480i stage is told the lookup takes 2 clocks (crt_480i LUT_LAT=2). As one clock into the
+	// 480i capture it failed timing (-0.37 ns at 64 MHz) or passed by a hair.
+	always_ff @(posedge clk) pal480_rgb <= { r480, g480, b480 };
+
